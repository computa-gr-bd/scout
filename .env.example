# ========== PostgreSQL ==========
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scoutvision
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/scoutvision

# ========== App ==========
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-prod
APP_PORT=8000
FRONTEND_PORT=5173

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== External Data Providers (Optional) ==========
# Leave empty to run in demo mode.
API_FOOTBALL_KEY=
STATSBOMB_LOCAL_DATA_PATH=

# ========== ML ==========
MODEL_PATH=./data/models
TRAIN_ON_STARTUP=false

# ========== JWT ==========
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
