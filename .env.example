# Neon: Connect -> PostgreSQL. Never use the https Data API URL here.
# The application accepts postgresql:// and selects the psycopg driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-prod
APP_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api

# football-data.org free token: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=
SYNC_COMPETITIONS=BSA

# Reserved for the separate API-Football provider, NOT football-data.org.
API_FOOTBALL_KEY=

# StatsBomb Open Data uses public JSON files, no key and no full clone required.
# Import selected matches only; check the provider's license before publication.
STATSBOMB_LOCAL_DATA_PATH=

MODEL_PATH=./data/models
TRAIN_ON_STARTUP=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
